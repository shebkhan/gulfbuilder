        ]
      ]
    },
    "Is Approval Callback?": {
      "main": [
        [
          {
            "node": "Decide Approval",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Answer Callback Query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Decide Approval": {
      "main": [
