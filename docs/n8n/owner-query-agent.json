{
  "name": "Gulf - Owner Query Agent",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "tgtrigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "m0TcrFMdHYuAkrSa",
          "name": "Gulf Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ ($json.callback_query?.data || '').startsWith('approve:') || ($json.callback_query?.data || '').startsWith('reject:') ? 'approval' : 'other' }}",
              "rightValue": "approval",
              "operator": {
                "type": "string",
                "operation": "equals",
                "rightValue": "approval"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "ifapproval",
      "name": "Is Approval Callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://gulfbuilder.vercel.app/api/v1/owner/approvals/' + ($json.callback_query.data.split(':')[1]) + '/decide' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ decision: $json.callback_query.data.split(':')[0] === 'approve' ? 'approved' : 'rejected' }) }}",
        "options": {}
      },
      "id": "decide",
      "name": "Decide Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        180
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "l9ZE1SyEtK8FLTfg",
          "name": "Gulf API Key"
        }
      }
    },
    {
      "parameters": {
        "operation": "answerCallbackQuery",
        "callbackQueryId": "={{ $('Telegram Trigger').first().json.callback_query.id }}",
        "additionalFields": {}
      },
      "id": "answercb",
      "name": "Answer Callback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        860,
        180
      ],
      "credentials": {
        "telegramApi": {
          "id": "m0TcrFMdHYuAkrSa",
          "name": "Gulf Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').first().json.callback_query.message.chat.id }}",
        "text": "={{ 'Approval ' + ($('Decide Approval').first().json.data.decision) + '.' }}",
        "additionalFields": {
          "replyMarkup": "inlineKeyboard"
        }
      },
      "id": "replyapproval",
      "name": "Reply Approval Done",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1080,
        180
      ],
      "credentials": {
        "telegramApi": {
          "id": "m0TcrFMdHYuAkrSa",
          "name": "Gulf Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "agent": "toolsAgent",
        "promptType": "define",
        "text": "={{ $json.callback_query?.data || $json.message?.text }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "You are the Gulf property assistant for an owner. Answer questions about their portfolio using the available tools. Always call a tool to get data; never guess. Summarize concisely. Amounts are in minor units; divide by 100 for QAR. When listing pending approvals, mention the approval id so the owner can approve via buttons."
        }
      },
      "id": "agent",
      "name": "Owner Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        640,
        420
      ]
    },
    {
      "parameters": {
        "model": {
          "mode": "id",
          "value": "gpt-4o-mini"
        }
      },
      "id": "openai",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        640,
        620
      ],
      "credentials": {
        "openAiApi": {
          "id": "V2LhZWF2IiVXfskY",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "name": "get_dashboard",
        "description": "Get owner dashboard KPIs.",
        "method": "GET",
        "url": "https://gulfbuilder.vercel.app/api/v1/owner/dashboard",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "t1",
      "name": "Tool Dashboard",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        880,
        260
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "l9ZE1SyEtK8FLTfg",
          "name": "Gulf API Key"
        }
      }
    },
    {
      "parameters": {
        "name": "get_cheques_due",
        "description": "Get cheques due within N days.",
        "method": "GET",
        "url": "https://gulfbuilder.vercel.app/api/v1/owner/cheques/due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "={{ $fromAI('days','number of days','number') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "t2",
      "name": "Tool Cheques Due",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        880,
        380
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "l9ZE1SyEtK8FLTfg",
          "name": "Gulf API Key"
        }
      }
    },
    {
      "parameters": {
        "name": "get_units_summary",
        "description": "Get units count by status.",
        "method": "GET",
        "url": "https://gulfbuilder.vercel.app/api/v1/owner/units/summary",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "t3",
      "name": "Tool Units Summary",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        880,
        500
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "l9ZE1SyEtK8FLTfg",
          "name": "Gulf API Key"
        }
      }
    },
    {
      "parameters": {
        "name": "get_leases",
        "description": "Get rent roll and leases expiring within N days.",
        "method": "GET",
        "url": "https://gulfbuilder.vercel.app/api/v1/owner/leases",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "expiring_days",
              "value": "={{ $fromAI('expiring_days','days','number') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "t4",
      "name": "Tool Leases",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        880,
        620
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "l9ZE1SyEtK8FLTfg",
          "name": "Gulf API Key"
        }
      }
    },
    {
      "parameters": {
        "name": "get_receivables",
        "description": "Get aged receivables.",
        "method": "GET",
        "url": "https://gulfbuilder.vercel.app/api/v1/owner/receivables",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "t5",
      "name": "Tool Receivables",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        880,
        740
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "l9ZE1SyEtK8FLTfg",
          "name": "Gulf API Key"
        }
      }
    },
    {
      "parameters": {
        "name": "get_digest",
        "description": "Get full daily digest.",
        "method": "GET",
        "url": "https://gulfbuilder.vercel.app/api/v1/owner/digest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "t6",
      "name": "Tool Digest",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        880,
        860
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "l9ZE1SyEtK8FLTfg",
          "name": "Gulf API Key"
        }
      }
    },
    {
      "parameters": {
        "name": "get_approvals",
        "description": "Get pending expense approvals with ids.",
        "method": "GET",
        "url": "https://gulfbuilder.vercel.app/api/v1/owner/approvals",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "t7",
      "name": "Tool Approvals",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        880,
        980
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "l9ZE1SyEtK8FLTfg",
          "name": "Gulf API Key"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger').first().json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Cheques due",
                    "additionalFields": {
                      "callback_data": "cheques due this week"
                    }
                  },
                  {
                    "text": "Units summary",
                    "additionalFields": {
                      "callback_data": "units summary"
                    }
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "Digest",
                    "additionalFields": {
                      "callback_data": "daily digest"
                    }
                  },
                  {
                    "text": "Maintenance",
                    "additionalFields": {
                      "callback_data": "open maintenance"
                    }
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "Receivables",
                    "additionalFields": {
                      "callback_data": "receivables"
                    }
                  },
                  {
                    "text": "Leases expiring",
                    "additionalFields": {
                      "callback_data": "leases expiring 30 days"
                    }
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "Approvals",
                    "additionalFields": {
                      "callback_data": "pending approvals"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "reply",
      "name": "Reply Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1100,
        420
      ],
      "credentials": {
        "telegramApi": {
          "id": "m0TcrFMdHYuAkrSa",
          "name": "Gulf Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "operation": "answerCallbackQuery",
        "callbackQueryId": "={{ $json.callback_query?.id }}",
        "additionalFields": {}
      },
      "id": "answercbq",
      "name": "Answer Callback Query",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        640,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "m0TcrFMdHYuAkrSa",
          "name": "Gulf Telegram Bot"
        }
      },
      "continueOnFail": true
    }
  ],
  "connections": {
    "Telegram Trigger": {
