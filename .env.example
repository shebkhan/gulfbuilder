# Supabase project: gulfproperty (ncytnjrjuuccskhvhmxa, Tokyo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64: `openssl rand -base64 32`
ID_ENCRYPTION_KEY=

# Notifications — email (Resend). Adapter also falls back to org_branding.email_from.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=

# Notifications — SMS / WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Notifications — Telegram. BOT_USERNAME is server-side; NEXT_PUBLIC_ is the client-facing copy.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Notifications — web push. Generate a pair with `npx web-push generate-vapid-keys`.
# WEB_PUSH_VAPID_PUBLIC_KEY and NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY MUST hold the SAME value.
WEB_PUSH_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Notifications — dispatch. POST /api/notifications/dispatch requires
# Authorization: Bearer $NOTIFICATION_CRON_SECRET; unauthenticated calls get 401.
NOTIFICATION_CRON_SECRET=
# Set to 1 to exercise dispatch locally without delivering messages.
NOTIFICATION_DRY_RUN=
